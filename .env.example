# ============================================
# OceanMate AI · 环境变量模板（占位符版）
# ============================================
#
# 用法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 把下方 <PLACEHOLDER> 替换成你的真实值（去掉尖括号）
#   3. .env 已在 .gitignore，不会被 git 追踪
#
# 安全：
#   - 千万不要把 .env 提交到 git
#   - 千万不要把真实凭证贴到聊天 / issue / 文档
#   - App Secret 泄露后立即在飞书后台重置
#
# 凭证来源：
#   - 飞书开放平台 https://open.feishu.cn/app
#   - 应用 → 凭证与基础信息：App ID + App Secret
#   - 应用 → 事件订阅：Verification Token
#   - 多维表格 → URL 路径：bascnxxx / tblxxx
# ============================================

# === 飞书集成（必填 · 缺一自动降级 Mock）===

# 飞书应用 App ID（cli_xxxxxxxxxxxxxxxx）
FEISHU_APP_ID=<PLACEHOLDER_FEISHU_APP_ID>

# 飞书应用 App Secret
FEISHU_APP_SECRET=<PLACEHOLDER_FEISHU_APP_SECRET>

# 事件订阅 Verification Token（飞书后台"事件订阅"页生成）
FEISHU_VERIFICATION_TOKEN=<PLACEHOLDER_FEISHU_VERIFICATION_TOKEN>

# === 飞书多维表格（可选 · 工单/知识库同步）===

# 多维表格 app_token（URL 中 bascn 开头的串）
FEISHU_BTABLE_APP_TOKEN=<PLACEHOLDER_BTABLE_APP_TOKEN>

# 多维表格 ID（URL 中 tbl 开头的串）
FEISHU_BTABLE_TABLE_ID=<PLACEHOLDER_BTABLE_TABLE_ID>

# === 强制 Mock（录屏 / 测试用 · 生产环境必须删除或留空）===

# 设为 1 强制走 MockFrontend（即使有凭证也不调真实飞书）
# FEISHU_FORCE_MOCK=1

# === 数据库 / Chroma（可选 · 默认本地路径）===

# OCEANMATE_DB=data/oceanmate.db
# OCEANMATE_CHROMA=data/chroma

# === Mock 日志路径（可选）===

# FEISHU_MOCK_LOG=.feishu_mock_log.json

# === Webhook 签名校验（可选 · 默认 False）===

# 启用 V1 签名校验（HMAC-SHA256）
# 启用条件：FEISHU_VERIFICATION_TOKEN 已配置 + main.py enable_signature_check=True
# FEISHU_ENABLE_SIGNATURE_CHECK=true